# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: path (under /public) or absolute HTTPS URL of your official logo.
# Leave blank to show the text wordmark. See public/brand/README.md.
NEXT_PUBLIC_BRAND_LOGO_URL=

# Optional: comma-separated emails allowed to sign in (private app guard).
# Leave blank to allow any account that exists in your Supabase project.
ALLOWED_EMAILS=
