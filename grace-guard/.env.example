# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public URL of the portal. Used for auth email links, canonical redirects
# and metadata. Keep http://localhost:3000 in .env.local for development.
NEXT_PUBLIC_SITE_URL=https://portal.gracenguard.com
# Optional runtime override for server code (no rebuild needed)
SITE_URL=

# Set to "true" in Vercel's *Production* environment only: redirects any other
# hostname (e.g. your-project.vercel.app) to NEXT_PUBLIC_SITE_URL.
ENFORCE_CANONICAL_HOST=false

# Optional: path (under /public) or absolute HTTPS URL of your official logo.
# Leave blank to show the text wordmark. See public/brand/README.md.
NEXT_PUBLIC_BRAND_LOGO_URL=

# Optional: comma-separated emails allowed to sign in (private app guard).
# Leave blank to allow any account that exists in your Supabase project.
ALLOWED_EMAILS=
